generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int               @id @default(autoincrement())
  username     String            @unique
  email        String            @unique
  passwordHash String
  avatarUrl    String?
  role         Role              @default(USER)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  userGames    UserGame[]
  reviews      Review[]
  posts        ForumPost[]
  comments     PostComment[]
  quizzes      Quiz[]
  quizResults  UserQuizResult[]
  gameLists    GameList[]
  newsPosts    NewsPost[]
  achievements UserAchievement[]
}

enum Role {
  USER
  ADMIN
}

model Game {
  id              Int         @id @default(autoincrement())
  rawgId          Int         @unique
  title           String
  coverImage      String?
  genre           String?
  releasedAt      DateTime?
  metacriticScore Int?
  userGames       UserGame[]
  reviews         Review[]
  posts           ForumPost[]
}

model UserGame {
  id                   Int        @id @default(autoincrement())
  userId               Int
  gameId               Int
  status               GameStatus
  hoursPlayed          Int?
  completionPercentage Int?
  addedAt              DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  game                 Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

enum GameStatus {
  backlog
  playing
  completed
  dropped
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  gameId    Int
  rating    Int
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model ForumPost {
  id        Int           @id @default(autoincrement())
  userId    Int
  gameId    Int?
  title     String
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game?         @relation(fields: [gameId], references: [id], onDelete: SetNull)
  comments  PostComment[]
}

model PostComment {
  id        Int       @id @default(autoincrement())
  userId    Int
  postId    Int
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Quiz {
  id          Int              @id @default(autoincrement())
  title       String
  description String?
  coverImage  String?
  isOfficial  Boolean          @default(false)
  createdById Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  questions   Question[]
  results     UserQuizResult[]
}

model Question {
  id           Int      @id @default(autoincrement())
  quizId       Int
  text         String
  options      String[]
  correctIndex Int
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model UserQuizResult {
  id             Int      @id @default(autoincrement())
  userId         Int
  quizId         Int
  score          Int
  totalQuestions Int
  completedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
}

// Listas/coleções temáticas de jogos criadas pelo usuário (CRUD de usuário)
model GameList {
  id          Int            @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  isPublic    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       GameListItem[]
}

model GameListItem {
  id         Int      @id @default(autoincrement())
  listId     Int
  rawgId     Int
  title      String
  coverImage String?
  addedAt    DateTime @default(now())
  list       GameList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, rawgId])
}

// Notícias/blog publicadas pela equipe (CRUD administrativo)
model NewsPost {
  id         Int      @id @default(autoincrement())
  authorId   Int
  title      String
  summary    String?
  content    String
  coverImage String?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// Conquistas: definições gerenciadas pelo admin + desbloqueio por usuário
model Achievement {
  id          Int               @id @default(autoincrement())
  code        String            @unique
  title       String
  description String
  icon        String?
  points      Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  users       UserAchievement[]
}

model UserAchievement {
  id            Int         @id @default(autoincrement())
  userId        Int
  achievementId Int
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}
