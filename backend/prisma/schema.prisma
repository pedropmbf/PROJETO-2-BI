generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  email        String        @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userGames    UserGame[]
  reviews      Review[]
  posts        ForumPost[]
  comments     PostComment[]
}

model Game {
  id              Int         @id @default(autoincrement())
  rawgId          Int         @unique
  title           String
  coverImage      String?
  genre           String?
  releasedAt      DateTime?
  metacriticScore Int?
  userGames       UserGame[]
  reviews         Review[]
  posts           ForumPost[]
}

model UserGame {
  id                   Int        @id @default(autoincrement())
  userId               Int
  gameId               Int
  status               GameStatus
  hoursPlayed          Int?
  completionPercentage Int?
  addedAt              DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  game                 Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

enum GameStatus {
  backlog
  playing
  completed
  dropped
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  gameId    Int
  rating    Int
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model ForumPost {
  id        Int           @id @default(autoincrement())
  userId    Int
  gameId    Int?
  title     String
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game?         @relation(fields: [gameId], references: [id], onDelete: SetNull)
  comments  PostComment[]
}

model PostComment {
  id        Int       @id @default(autoincrement())
  userId    Int
  postId    Int
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}
